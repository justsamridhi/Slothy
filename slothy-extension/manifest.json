{
  "manifest_version": 3,
  "name": "Slothy",
  "version": "0.2.0",
  "description": "Slow down. Get the gist. Local summaries, visual mind maps, takeaways and action items.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Slothy",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "windows"
  ],
  "host_permissions": [
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*"
  ]
}
